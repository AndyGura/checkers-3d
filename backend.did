type View = 
 variant {
   awaitingRematch: record {
                      gen: nat;
                      openSeat: Seat;
                    };
   busy: record {secondsUntilTakeover: nat;};
   debrief:
    record {
      end: End;
      finalGame: State;
      gen: nat;
      seat: Seat;
      turns: nat;
    };
   endedByOther;
   inGame:
    record {
      claimTimeoutSecs: nat;
      claimWinAvailable: bool;
      game: State;
      gen: nat;
      idleTimeoutSecs: nat;
      mode: Mode;
      oppSubmitted: bool;
      seat: Seat;
      secondsUntilClaimable: nat;
      secondsUntilIdleReset: nat;
      turn: nat;
      youSubmitted: bool;
    };
   lobby: record {
            p1Open: bool;
            p2Open: bool;
            resetAvailable: bool;
          };
   stagingYou:
    record {
      gen: nat;
      reservedForPartner: bool;
      seat: Seat;
      visibility: TableVisibility;
    };
 };
type Verdict = 
 variant {
   draw;
   p1Wins;
   p2Wins;
 };
type TableVisibility = 
 variant {
   code: text;
   open;
 };
type TableSummary = 
 record {
   id: TableId;
   p1Open: bool;
   p1Session: opt SessionId;
   p2Open: bool;
   p2Session: opt SessionId;
   protected: bool;
   "variant": text;
   waitingSecs: nat;
 };
type TableId = nat;
type StreamingToken = record {index: nat;};
type StreamingStrategy = variant {
                           Callback:
                            record {
                              callback: StreamingCallback;
                              token: StreamingToken;
                            };};
type StreamingCallbackResponse = 
 record {
   body: blob;
   token: opt StreamingToken;
 };
type StreamingCallback = func (StreamingToken) ->
                          (StreamingCallbackResponse) query;
type State = record {board: Board;};
type SessionStatus = 
 variant {
   atTable: record {
              id: TableId;
              view: View;
            };
   browsing: record {tables: vec TableSummary;};
 };
type SessionId = text;
type Seat = 
 variant {
   p1;
   p2;
 };
type Response = 
 record {
   body: blob;
   headers: vec record {
                  text;
                  text;
                };
   status_code: nat16;
   streaming_strategy: opt StreamingStrategy;
 };
type Res_2 = 
 variant {
   err: Err;
   ok: TableId;
 };
type Res_1 = 
 variant {
   err: Err;
   ok: JoinOk;
 };
type Res = 
 variant {
   err: Err;
   ok;
 };
type Request = 
 record {
   body: blob;
   headers: vec record {
                  text;
                  text;
                };
   method: text;
   url: text;
 };
type Principal = principal;
type PollResult = 
 variant {
   changed: blob;
   unchanged;
   unknown;
 };
type Piece = 
 variant {
   kingP1;
   kingP2;
   manP1;
   manP2;
 };
type Mode = 
 variant {
   alternating;
   simultaneous;
 };
type JoinOk = 
 variant {
   staged: Seat;
   started: Seat;
 };
type Err = 
 variant {
   alreadySubmitted;
   badCode;
   illegalMove: text;
   noSuchTable;
   notIdle: record {secondsLeft: nat;};
   notOverdue: record {secondsLeft: nat;};
   notSeated;
   notYourTurn;
   "reserved": record {secondsLeft: nat;};
   seatTaken;
   stale;
   unauthorized;
   wrongPhase: text;
 };
type Entry = 
 record {
   player: text;
   score: int;
   updatedAt: int;
 };
type End = 
 variant {
   aborted: Seat;
   claimed: Seat;
   finished: Verdict;
 };
type BotEntry = 
 record {
   complexities: vec BotComplexityEntry;
   name: text;
   "principal": Principal;
 };
type BotComplexityEntry = 
 record {
   complexity: text;
   elo: opt int;
 };
type Board = vec opt Piece;
service : {
  ack_ended_as_canister: (tableId: TableId) -> ();
  claim_win_as_canister: (tableId: TableId, gen: nat) -> (Res);
  create_table_as_canister: (seat: Seat, visibility: TableVisibility,
   "variant": text, complexity: text) -> (Res_2);
  duel_poll: (sid: text, rev: nat) -> (PollResult) query;
  duel_request: (msg: blob) -> (blob);
  get_leaderboard: () -> (vec Entry) query;
  http_request: (req: Request) -> (Response) query;
  http_request_streaming_callback: (token: StreamingToken) ->
   (StreamingCallbackResponse) query;
  join_table_as_canister: (id: TableId, seat: Seat, code: opt text,
   complexity: text) -> (Res_1);
  leave_as_canister: (tableId: TableId, gen: nat) -> (Res);
  list_bots: () -> (vec BotEntry) query;
  register_bot: (name: text, complexities: vec text) -> ();
  reset_as_canister: (tableId: TableId, gen: nat) -> (Res);
  status: (sid: text) -> (SessionStatus) query;
  unregister_bot: () -> ();
  wasm_upload_begin: () -> ();
  wasm_upload_chunk: (chunk: blob) -> ();
  wasm_upload_commit: (size: nat) -> ();
}

