{
  "name": "checkers-3d-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "A 3D frontend for the live duel-game-core Checkers backend, bundled with esbuild (no framework).",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@icp-sdk/auth": "^8.0.3",
    "@icp-sdk/core": "^6.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
